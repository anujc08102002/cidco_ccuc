PORT=3001
CORS_ORIGIN=http://localhost:5173
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=EnforceFlow
DB_AUTH=sql
DB_USER=enforceflow_api
DB_PASSWORD=Replace-This-API-Password-2026!
DB_ENCRYPT=true
DB_TRUST_CERTIFICATE=true
# Optional PDF font path for other operating systems or languages (TTF/TTC).
NOTICE_FONT_PATH=
# Optional departmental sender for the explicit 'Send from application' action.
# Gmail/Outlook drafts work without SMTP. Keep real credentials only in .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
APP_PUBLIC_URL=http://localhost:5173
# Optional shared Web Push identity for multi-server deployments. When omitted,
# this workstation generates and persists server/.push-vapid.json automatically.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://cidco.maharashtra.gov.in
